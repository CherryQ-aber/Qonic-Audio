third_party/source-archives/
third_party/upstream-assets/
ncmdump-1.5.1-windows-amd64.zip
third_party/ffmpeg-build/*.bak

# Large local binaries and audio fixtures
Tools/ffmpeg/bin/*.exe
Tools/ncmdump/ncmdump.exe
Test_Files/*
!Test_Files/README.md
!Test_Files/converted/README.md

