# Qonic-maintained FFmpeg self-build workspaces and candidate binaries
third_party/ffmpeg-build/sources/*
!third_party/ffmpeg-build/sources/.gitkeep
third_party/ffmpeg-build/work/*
!third_party/ffmpeg-build/work/.gitkeep
